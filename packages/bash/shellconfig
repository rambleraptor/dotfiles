# Enable ** recursive globbing for the loader below.
shopt -s globstar nullglob

# load all of the bash files (skip zsh-specific packages)
for file in "$DOTFILES"/**/*.bash; do
  case "$file" in
    "$DOTFILES"/packages/zsh/*) continue ;;
  esac
  source "$file"
done

shopt -u nullglob

# Vi mode with ctrl-r kept on reverse-search-history.
set -o vi
bind '"\C-r": reverse-search-history' 2>/dev/null
